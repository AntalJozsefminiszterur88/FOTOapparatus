<Window
    x:Class="FOTOapparatus.UI.MainWindow"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="avares://FOTOapparatus.UI/Assets/camera_icon.png"
    MinHeight="760"
    MinWidth="640"
    Title="FOTO-Apparátus"
    Width="640"
    Height="760"
    Closing="Window_OnClosing"
    Opened="Window_OnOpened">
  <Border Padding="18">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Classes="card" Grid.Column="0">
          <StackPanel Spacing="8">
            <TextBlock Classes="section-title" Text="Felvétel mód" />
            <RadioButton GroupName="CaptureType" IsChecked="{Binding IsCaptureScreenshot}">Képernyőkép</RadioButton>
            <RadioButton GroupName="CaptureType" IsChecked="{Binding IsCaptureProgram}">Programkép</RadioButton>
            <Grid ColumnDefinitions="*,Auto">
              <RadioButton GroupName="CaptureType" IsChecked="{Binding IsCaptureDiscord}">Discord mód</RadioButton>
              <Button Grid.Column="1" Click="DiscordSettingsButton_OnClick" IsEnabled="{Binding CanOpenDiscordSettings}">Beállítások</Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="1">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Classes="section-title" Grid.Row="0" Text="Mentési hely" />
            <Button Grid.Row="1" HorizontalAlignment="Left" Click="FolderButton_OnClick">Mentési mappa...</Button>
            <TextBlock
                Grid.Row="2"
                Classes="muted"
                Text="{Binding SavePath}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />
            <Button Grid.Row="3" HorizontalAlignment="Right" Classes="primary" Click="SaveButton_OnClick" MinWidth="110">Mentés</Button>
          </Grid>
        </Border>
      </Grid>

      <Border Classes="card" Grid.Row="1" Margin="0,12,0,0" IsVisible="{Binding IsSizeOptionsVisible}">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="section-title" Margin="0,0,0,0" Text="Screenshot mérete" VerticalAlignment="Center" />
            <Button x:Name="TestButton" Grid.Column="1" Click="TestButton_OnClick" Width="72">Teszt</Button>
          </Grid>

          <RadioButton Grid.Row="1" GroupName="ScreenshotMode" IsChecked="{Binding IsFullscreenMode}">Teljes képernyő</RadioButton>

          <StackPanel Grid.Row="2" Spacing="8">
            <RadioButton GroupName="ScreenshotMode" IsChecked="{Binding IsCustomMode}">Egyéni terület</RadioButton>
            <Grid ColumnDefinitions="Auto,*" Margin="16,0,0,0">
              <Button Click="SelectAreaButton_OnClick" IsEnabled="{Binding IsCustomMode}">Terület kijelölése...</Button>
              <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding CustomAreaDisplay}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" Grid.Row="2" Margin="0,12,0,0" IsVisible="{Binding IsProgramWindowVisible}">
        <StackPanel Spacing="8">
          <TextBlock Classes="section-title" Text="Alkalmazás kiválasztása" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding AvailableWindows}" SelectedItem="{Binding SelectedProgramWindow}" />
            <Button Grid.Column="1" Click="RefreshWindowsButton_OnClick">Frissítés</Button>
          </Grid>
        </StackPanel>
      </Border>

      <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Classes="card" Grid.Column="0">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="Dátum beállítások" />
            <CheckBox IsChecked="{Binding IncludeTimestamp}">Dátum kiírása</CheckBox>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="10">
              <RadioButton Grid.Row="0" Grid.Column="0" GroupName="TimestampPosition" IsChecked="{Binding IsTimestampTopLeft}">Bal felső</RadioButton>
              <RadioButton Grid.Row="0" Grid.Column="1" GroupName="TimestampPosition" IsChecked="{Binding IsTimestampTopRight}">Jobb felső</RadioButton>
              <RadioButton Grid.Row="1" Grid.Column="0" GroupName="TimestampPosition" IsChecked="{Binding IsTimestampBottomLeft}">Bal alsó</RadioButton>
              <RadioButton Grid.Row="1" Grid.Column="1" GroupName="TimestampPosition" IsChecked="{Binding IsTimestampBottomRight}">Jobb alsó</RadioButton>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="További beállítások" />
            <CheckBox
                x:Name="AutostartCheckBox"
                Click="AutostartCheckBox_OnClick"
                IsChecked="{Binding AutostartEnabled}"
                IsVisible="{Binding AutostartSupported}">
              Indítás a rendszerrel
            </CheckBox>

            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
              <CheckBox Grid.Column="0" IsChecked="{Binding IdleCheckEnabled}" VerticalAlignment="Center">Csak inaktivitás esetén</CheckBox>
              <NumericUpDown
                  Grid.Column="1"
                  FormatString="0 'perc'"
                  Increment="1"
                  IsEnabled="{Binding IsIdleThresholdEnabled}"
                  Maximum="120"
                  Minimum="1"
                  Value="{Binding IdleThresholdMinutes}"
                  Width="96" />
              <TextBlock Grid.Column="2" Classes="muted" Text="Az időzített képkészítés csak a megadott inaktivitási idő után indul." TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card" Grid.Row="4" Margin="0,12,0,0" MinHeight="260">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="section-title" Margin="0,0,0,0" Text="Ütemezések" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="AddScheduleButton_OnClick">+ Új időzítő</Button>
          </Grid>

          <ScrollViewer
              Grid.Row="1"
              Margin="0,12,0,0"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Schedules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,8" Padding="10">
                    <Grid ColumnDefinitions="88,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                      <MaskedTextBox
                          Mask="00:00"
                          PromptChar="_"
                          Text="{Binding TimeText}"
                          Width="88" />
                      <CheckBox Grid.Column="1" Content="H" IsChecked="{Binding DayMonday}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="2" Content="K" IsChecked="{Binding DayTuesday}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="3" Content="Sze" IsChecked="{Binding DayWednesday}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="4" Content="Cs" IsChecked="{Binding DayThursday}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="5" Content="P" IsChecked="{Binding DayFriday}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="6" Content="Szo" IsChecked="{Binding DaySaturday}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="7" Content="V" IsChecked="{Binding DaySunday}" VerticalAlignment="Center" />
                      <Button Grid.Column="8" Click="RemoveScheduleButton_OnClick" Tag="{Binding}" Width="32">-</Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <TextBlock Grid.Row="5" Classes="muted" Margin="4,12,4,0" Text="{Binding StatusMessage}" />
    </Grid>
  </Border>
</Window>
